# Copy this file to .env (which is ignored by Git) and fill in the values.
# NEVER put real secrets in this file. Production secrets live in Secret Manager.
# Names follow docs/infra.md.

# --- Server ---
NODE_ENV=development
# Cloud Run injects PORT on its own; 8080 is the default.
PORT=8080

# --- Firebase ---
GOOGLE_CLOUD_PROJECT=estoque-pay
# Local Emulator Suite (ports are set in firebase.json). Leave these set in
# development so the API never touches the production database by accident.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- Seed script ---
# Secret. Password of the test accounts created by `npm run seed`. Local .env only.
SEED_TEST_PASSWORD=

# --- Authentication ---
# Passkey RP ID. Do not change it: it invalidates the existing passkeys.
PASSKEY_RP_ID=uni-books.app
# Origins accepted for the Android app passkey, separated by commas, each as
# android:apk-key-hash:<SHA-256 of the signing certificate, base64url>.
# Comes from the app certificate, it is not a secret.
PASSKEY_ANDROID_ORIGINS=
# Domain of the internal e-mail of each Firebase account (<matricula>@<domain>).
AUTH_EMAIL_DOMAIN=contas.uni-books.app

# --- E-mail (Resend) ---
# Secret
RESEND_API_KEY=
EMAIL_FROM="Unifor Biblioteca <nao-responda@email.uni-books.app>"

# --- Holidays (FeriadosAPI) ---
# Secret
FERIADOS_API_KEY=

# --- Assistant (Gemini) ---
# Secret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
